<% content_for :title, "Photo Library" %>

<section class="hero">
  <p class="eyebrow">Personal photo library</p>
  <h1>Photo Library</h1>
  <p class="lede">Search, review, and organize the moments in your collection.</p>
  <div class="actions">
    <%= link_to "Search photos", "/search", class: "button button-primary" %>
    <%= link_to "View catalog", "/catalog/overview", class: "button" %>
  </div>
</section>

<section class="dashboard-grid" aria-label="Library status">
  <article class="dashboard-card">
    <p class="card-label">Searchable photos</p>
    <p class="metric"><%= @overview[:funnel]["searchable"] %></p>
    <%= link_to "Open search", "/search" %>
  </article>
  <article class="dashboard-card">
    <p class="card-label">People to review</p>
    <p class="metric"><%= @overview[:context][:faces][:unassigned] %></p>
    <%= link_to "Review people", persons_path %>
  </article>
  <article class="dashboard-card">
    <p class="card-label">Locations</p>
    <p class="metric"><%= @overview[:context][:places][:located] %></p>
    <%= link_to "View catalog", "/catalog/overview" %>
  </article>
</section>

<section class="dashboard-panel">
  <div>
    <p class="eyebrow">Import activity</p>
    <h2>Keep your library growing</h2>
    <p>Upload a photo or scan the configured folder from the admin tools.</p>
  </div>
  <%= link_to "View jobs", "/jobs", class: "button" %>
</section>
