<h1>Jobs</h1>
<%= turbo_frame_tag "jobs" do %>
  <table>
    <tr><th>id</th><th>kind</th><th>status</th><th>progress</th><th>error</th></tr>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= job.id %></td>
        <td><%= job.kind %></td>
        <td><%= job.status %></td>
        <td><%= (job.progress * 100).round %>%</td>
        <td><%= job.error %></td>
      </tr>
    <% end %>
  </table>
<% end %>
