# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# macOS Finder metadata
.DS_Store

# Ignore bundler config.
/.bundle

# Ignore all environment files, wherever they appear.
*.env*
!*.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Runtime photo library data.
/library/*
!/library/imports/
/library/imports/*
!/library/imports/.keep

# Runtime model weights.
/models/*
!/models/.keep

/public/assets

# Swift package build output.
/apps/photos-bridge/.build/

# Ignore key files for decrypting credentials and more.
/config/*.key

# Machine-specific Kamal local overlay (generated by script/kamal-local.sh).
/config/deploy.local.yml

# Local Kamal destination secrets (generated/maintained outside Git).
/.kamal/secrets.local
